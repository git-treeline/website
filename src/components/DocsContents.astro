---
interface Props {
  items: { id: string; label: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="On this page" class="mx-4 sm:mx-6 lg:mx-0 mb-10 rounded-lg border border-surface-border bg-surface-raised p-4 sm:p-5">
  <p class="text-sm font-semibold text-white mb-3">On this page</p>
  <ul class="grid sm:grid-cols-2 gap-x-6 gap-y-2 text-sm">
    {items.map(({ id, label }) => (
      <li><a href={`#${id}`} class="text-accent-light hover:text-accent underline underline-offset-4">{label}</a></li>
    ))}
  </ul>
</nav>
