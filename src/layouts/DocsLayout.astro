---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  description: string;
  canonical: string;
  activePage?: string;
  jsonLd?: string;
}

const { title, description, canonical, activePage, jsonLd: pageJsonLd } = Astro.props;

const navGroups = [
  {
    heading: 'Reference',
    items: [
      { slug: 'getting-started', label: 'Getting started' },
      { slug: 'configuration', label: 'Configuration' },
      { slug: 'cli', label: 'CLI reference' },
      { slug: 'troubleshooting', label: 'Troubleshooting' },
    ],
  },
  {
    heading: 'Guides',
    items: [
      { slug: 'lifecycle', label: 'Lifecycle' },
      { slug: 'hooks', label: 'Hooks' },
      { slug: 'networking', label: 'Networking' },
      { slug: 'database', label: 'Database' },
      { slug: 'editor', label: 'Editor' },
      { slug: 'resolve', label: 'Resolve' },
      { slug: 'supervisor', label: 'Supervisor' },
      { slug: 'agents', label: 'AI agents' },
    ],
  },
];

const allItems = navGroups.flatMap((g) => g.items);

const activeLabel = allItems.find((i) => i.slug === activePage)?.label ?? '';

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://git-treeline.dev" },
    { "@type": "ListItem", position: 2, name: "Docs", item: "https://git-treeline.dev/docs/" },
    ...(activePage ? [{ "@type": "ListItem", position: 3, name: activeLabel, item: canonical }] : []),
  ],
};

const techArticleLd = activePage ? {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: title.replace(/ \| Git Treeline$/, ''),
  description,
  url: canonical,
  author: { "@type": "Person", name: "Jonathan Simmons" },
  publisher: { "@type": "Organization", name: "Git Treeline", url: "https://git-treeline.dev" },
  mainEntityOfPage: canonical,
} : null;

const jsonLdBlocks = pageJsonLd
  ? [pageJsonLd]
  : [breadcrumbLd, techArticleLd].filter(Boolean).map((b) => JSON.stringify(b));

const docsKeywords = 'git worktree, worktree provisioner, git-treeline, branch isolation, local dev environment, parallel development';
---

<style is:inline>
  #docs-sidebar { display: none; }
  #docs-sidebar > div { position: sticky; top: 4rem; }
  #docs-mobile-nav { position: sticky; top: 3.5rem; z-index: 40; }
  #docs-mobile-nav summary { list-style: none; }
  #docs-mobile-nav summary::-webkit-details-marker { display: none; }
  #docs-mobile-nav details[open] summary svg { transform: rotate(180deg); }
  .docs-content .reference-heading { margin: 0; font-size: 1rem; scroll-margin-top: 7rem; }
  .docs-content .heading-link { color: inherit; text-decoration: none; }
  .docs-content .heading-link:hover { color: var(--color-accent-light); }
  .docs-content .heading-link:focus-visible { outline: 2px solid var(--color-accent-light); outline-offset: 4px; }
  .docs-content .heading-link > span { color: var(--color-muted); font-weight: normal; margin-left: 0.5rem; }
  @media (min-width: 1024px) {
    #docs-sidebar { display: block; }
    #docs-layout { display: flex; }
  }
</style>

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  activeNav="docs"
  installHref="/#get-started"
  ogType={activePage ? 'article' : 'website'}
  keywords={docsKeywords}
  jsonLd={jsonLdBlocks}
>
  <div id="docs-layout" class="lg:max-w-5xl lg:mx-auto lg:gap-10 lg:px-6">
    <aside id="docs-sidebar" class="w-48 shrink-0">
      <div class="pt-24 pb-10 overflow-y-auto max-h-screen">
        {navGroups.map((group) => (
          <div class="mb-6">
            <p class="text-xs uppercase tracking-wider text-muted font-medium mb-3">{group.heading}</p>
            <ul class="space-y-1">
              {group.items.map((item) => (
                <li>
                  <a
                    href={`/docs/${item.slug}/`}
                    aria-current={activePage === item.slug ? 'page' : undefined}
                    class={`text-sm text-muted hover:text-white transition-colors block py-1.5 pl-3 border-l-2 ${activePage === item.slug ? 'text-accent-light border-accent-light' : 'border-transparent'}`}
                  >{item.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </aside>

    <div class="flex-1 min-w-0 docs-content">
      <nav
        id="docs-mobile-nav"
        aria-label="Documentation"
        class="lg:hidden bg-surface border-b border-surface-border px-4 sm:px-6 py-3"
      >
        <details data-nav-disclosure>
          <summary
            class="flex items-center gap-2 text-sm text-accent-light hover:text-accent transition-colors cursor-pointer"
          >
            Navigation
            <svg
              class="w-3 h-3 transition-transform duration-150"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"></path>
            </svg>
          </summary>
          <div class="mt-4 pb-2 space-y-4 text-sm max-h-[calc(100dvh-8rem)] overflow-y-auto" id="mobile-docs-nav">
            {navGroups.map((group) => (
              <div>
                <p class="text-xs uppercase tracking-wider text-muted font-medium mb-2">{group.heading}</p>
                <ul class="space-y-1.5">
                  {group.items.map((item) => (
                    <li>
                      <a
                        href={`/docs/${item.slug}/`}
                        aria-current={activePage === item.slug ? 'page' : undefined}
                        class={`block py-1 ${activePage === item.slug ? 'text-accent-light' : 'text-muted hover:text-white'} transition-colors`}
                      >{item.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </details>
      </nav>
      <slot />
    </div>
  </div>
</BaseLayout>
