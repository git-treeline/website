        <div class="py-6 sm:py-5 border-b border-surface-border last:border-b-0">
          <span class="font-mono text-white text-base font-semibold">config path</span>
          <p class="text-base text-muted mt-2">Print config file location.</p>
        </div>

        <div class="py-6 sm:py-5 border-b border-surface-border last:border-b-0">
          <span class="font-mono text-white text-base font-semibold">config edit</span>
          <p class="text-base text-muted mt-2">
            Open config in <code class="text-accent-light">$EDITOR</code>.
          </p>
        </div>

        <div class="py-6 sm:py-5 border-b border-surface-border last:border-b-0">
          <span class="font-mono text-white text-base font-semibold">editor refresh</span>
          <p class="text-base text-muted mt-2">
            Re-apply editor title, color, and theme for the current worktree.
          </p>
        </div>

        <div class="py-6 sm:py-5 border-b border-surface-border last:border-b-0">
          <span class="font-mono text-white text-base font-semibold">completion bash|zsh|fish|powershell</span>
          <p class="text-base text-muted mt-2">
            Print shell completion script. Includes dynamic completions for config keys and project names.
          </p>
        </div>
      </div>
    </div>

